{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synterx-store",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/.netlify/functions/*",
      "/health"
    ]
  }
}
